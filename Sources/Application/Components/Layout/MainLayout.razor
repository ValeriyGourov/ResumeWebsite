@inherits LocalizedLayoutComponentBase

<main>
	<div class="c-preloader  js-preloader">
		<div class="c-preloader__spinner  t-preloader__spinner"></div>
	</div>

	<div class="c-main-container  js-main-container">

		<div class="top-menu">

			<CultureSwitcher />

			<MenuItem Text="@localizer["PdfFileButtonText"]"
					  IconName="file-pdf-solid"
					  Title="@localizer["PdfFileButtonTitle"]"
					  OnClickHandler="DownloadPdfAsync" />

		</div>

		<article>
			@Body
		</article>

	</div>
</main>

<div id="blazor-error-ui" data-nosnippet>
	@localizer["UnhandledErrorOccurred"]
	<a href="." class="reload">@localizer["Reload"]</a>
	<span class="dismiss">🗙</span>
</div>
